[Unit]
Description=mihomo for clash-converter listeners
After=network.target

[Service]
ExecStart=/usr/local/bin/mihomo -d /opt/clash-converter-10000/data/mihomo -f /opt/clash-converter-10000/data/mihomo/config.yaml
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
