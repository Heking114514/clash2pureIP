# WebUI login
WEBUI_USER=admin
WEBUI_PASS=change-me

# Runtime data: mihomo config, state, and generated keys
CLASH_DATA=/opt/clash-converter-10000/data

# Service restarted after a subscription is converted
MIHOMO_RESTART_CMD=systemctl restart mihomo-conv-10000

# Use 127.0.0.1 for same-host access; 0.0.0.0 exposes proxy listeners publicly
LISTEN_HOST=127.0.0.1

# Hostname or public IP written into generated proxy URLs
PUBLIC_HOST=

# Credentials shared by the generated HTTP and SOCKS5 proxy endpoints
PROXY_USER=proxyuser
PROXY_PASS=change-me

