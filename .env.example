# WebUI login
WEBUI_USER=admin
WEBUI_PASS=change-me

# Runtime data: mihomo config, state, pool and subscription cache
CLASH_DATA=/opt/clash-converter-v2/data

# Service restarted after a subscription is converted
MIHOMO_RESTART_CMD=systemctl restart mihomo-conv-v2

# Use 127.0.0.1 for same-host access; 0.0.0.0 exposes proxy listeners publicly
LISTEN_HOST=127.0.0.1

# Hostname or public IP written into generated proxy URLs
PUBLIC_HOST=

# Credentials shared by all generated HTTP proxy endpoints
PROXY_USER=proxyuser
PROXY_PASS=change-me
